# reparto-sync — EL SINCRONIZADOR. Bajada por diferencias, subida por lotes y el
# registro de aparatos: lo que hace posible que un logístico trabaje un día sin red.
#
# EL CONTEXTO ES LA RAÍZ DEL REPO (este fichero vive en deploy/ y el código en sync/):
#
#   docker build -f deploy/Dockerfile.sync -t reparto-sync .
#
# En Dokploy:  Dockerfile Path = deploy/Dockerfile.sync  ·  Docker Context Path = .
#
# OJO CON EL PUERTO: la identidad de quien llama sale HOY de las cabeceras que pone el
# proxy de delante (`X-Persona`, `X-Sucursal`, `X-Super-Admin`, ver sync/internal/
# identidad). Eso sólo es seguro si nadie más puede llegar a este puerto. Por eso
# `SYNC_IDENTIDAD` no tiene valor por defecto y hay que escribirlo a mano.
ARG GO_VERSION=1.27

FROM golang:${GO_VERSION}-alpine AS build
WORKDIR /src

RUN apk add --no-cache git

ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

# SQLC, PARA COMPROBAR QUE EL CÓDIGO GENERADO ES EL DE LAS CONSULTAS — 22/09/2026
#
# Capa propia y arriba del todo: sólo se rehace al cambiar de versión, no en cada
# despliegue. Lo que tapa: `internal/store/sqlc/*.sql.go` está GENERADO, y editarlo a mano
# deja `vet`, `test` y `build` en verde mientras lo que corre ya no es lo que dicen las
# consultas ni lo que vigilan las guardas, que leen los `.sql`. `comprobar.sh` hace este
# diff, pero `comprobar.sh` no corre en el servidor y un push reconstruye esta imagen sin
# preguntarle nada a esta máquina — que es EXACTAMENTE cómo llegó aquí la mutación del
# 16/09 que se cuenta más abajo.
ARG SQLC_VERSION=v1.31.1
RUN go install github.com/sqlc-dev/sqlc/cmd/sqlc@${SQLC_VERSION}

COPY sync/go.mod sync/go.sum ./
RUN go mod download

COPY sync/ .

ENV CGO_ENABLED=0
# LAS PRUEBAS, ANTES DE CONSTRUIR. No es celo: es lo que faltaba el 16/09/2026.
#
# Ese día se subió a `main`, sin querer, una mutación de prueba —una guarda invertida a
# propósito para comprobar que hay un test que la caza— y Dokploy reconstruyó esta imagen
# 29 segundos después. Como aquí sólo se compilaba, la mutación compiló, se desplegó, y
# producción estuvo media hora corriéndola: el reenvío del token de la persona quedaba
# anulado y la cola del tablero volvía a contestar 401.
#
# Las pruebas SÍ la cazaban. Nadie se lo preguntó a nadie. Costaba diez segundos aquí.
#
# Y ANTES QUE LAS PRUEBAS, EL DIFF: una prueba que lee el `.sql` no se entera de que el
# `.sql.go` dice otra cosa. Si no cuadran, esta imagen no construye.
RUN sqlc diff

RUN go vet ./... && go test ./...

RUN go build -trimpath -ldflags="-s -w" -o /out/sync ./cmd/sync

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/sync /app/sync

# El mismo que SYNC_ADDR (":8081" por defecto).
EXPOSE 8081
USER nonroot:nonroot
ENTRYPOINT ["/app/sync"]

# Variables de reparto-api. Las dos primeras son OBLIGATORIAS: sin ellas el servicio
# NO ARRANCA, con un mensaje que dice cuáles faltan. Es a propósito — una variable que
# falta y se descubre al atender la primera petición que la necesita es un 500 a media
# tarde, en la pantalla de alguien que está cargando un camión.

# Postgres. Uno solo para toda la casa, con muchas bases (ver ../../CLAUDE.md).
DATABASE_URL=postgres://usuario:clave@localhost:5432/procovar_reparto

# El MISMO secreto con el que firma auth.procovar.cloud. Mínimo 32 caracteres: uno
# corto se rompe por fuerza bruta fuera de línea, y el token que sale de ahí abre la
# sucursal entera.
JWT_SECRET=

# --- Lo demás tiene valor por defecto -------------------------------------------

# La puerta del espejo de PEDIDO y de las tareas de fondo (cabecera x-api-key). Si se
# deja vacía, esas rutas quedan CERRADAS — nunca abiertas de par en par.
SERVICE_API_KEY=

ENTORNO=desarrollo          # desarrollo | produccion
PUERTO=8080
VERSION_APP=                # normalmente la incrusta el compilador con -ldflags

# La web de Flutter va en otro dominio. Lista cerrada y separada por comas: con `*` no
# se pueden mandar cookies, y la sesión de la web es una cookie.
ORIGENES_PERMITIDOS=http://localhost:8081

POOL_MAX_CONNS=10
POOL_MIN_CONNS=2
POOL_MAX_IDLE=5m
TIEMPO_LECTURA=15s
TIEMPO_ESCRITURA=30s
# No más que el plazo que da quien nos para (Docker manda SIGKILL a los 10 s).
TIEMPO_APAGADO=8s

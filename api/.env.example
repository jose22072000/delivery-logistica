# Variables de reparto-api. Las dos primeras son OBLIGATORIAS: sin ellas el servicio
# NO ARRANCA, con un mensaje que dice cuáles faltan. Es a propósito — una variable que
# falta y se descubre al atender la primera petición que la necesita es un 500 a media
# tarde, en la pantalla de alguien que está cargando un camión.

# Postgres. Uno solo para toda la casa, con muchas bases (ver ../../CLAUDE.md).
DATABASE_URL=postgres://usuario:clave@localhost:5432/procovar_reparto

# El MISMO secreto con el que firma auth.procovar.cloud. Mínimo 32 caracteres: uno
# corto se rompe por fuerza bruta fuera de línea, y el token que sale de ahí abre la
# sucursal entera.
JWT_SECRET=

# --- Lo demás tiene valor por defecto -------------------------------------------

# La puerta del espejo de PEDIDO y de las tareas de fondo (cabecera x-api-key). Si se
# deja vacía, esas rutas quedan CERRADAS — nunca abiertas de par en par.
SERVICE_API_KEY=

ENTORNO=desarrollo          # desarrollo | produccion
PUERTO=8080
VERSION_APP=                # normalmente la incrusta el compilador con -ldflags

# La web de Flutter va en otro dominio. Lista cerrada y separada por comas: con `*` no
# se pueden mandar cookies, y la sesión de la web es una cookie.
ORIGENES_PERMITIDOS=http://localhost:8081

POOL_MAX_CONNS=10
POOL_MIN_CONNS=2
POOL_MAX_IDLE=5m
TIEMPO_LECTURA=15s
TIEMPO_ESCRITURA=30s
# No más que el plazo que da quien nos para (Docker manda SIGKILL a los 10 s).
TIEMPO_APAGADO=8s

# --- Las otras aplicaciones de la casa ------------------------------------------

# PEDIDO. Hace falta para DOS cosas: el canal que le cuenta en qué punto del reparto va
# cada pedido (`despachado`, `en_transito`, `entregado`/`devuelto`/`cancelado`) y el
# recosteo de `POST /api/admin/recompute`.
#
# NO es obligatoria para arrancar, a propósito: sin ella el servicio hace todo lo demás y
# esas dos cosas LO DICEN —el canal devuelve `ok:false` con el motivo y lo deja en el
# registro; el recosteo, un 500 con el nombre de esta variable dentro—. Nunca un `ok:true`
# sin haber avisado: un aviso que nadie recibe y que además se declara enviado es peor que
# no avisar, porque nadie lo busca.
#
# El canal usa además SERVICE_API_KEY (arriba) como `x-api-key`. Sin una de las dos, no sale.
PEDIDO_API_URL=

# A dónde manda el recosteo su lote a cotizar. Vacía es «a mí mismo»
# (http://127.0.0.1:PUERTO), que es lo correcto mientras esto sea un solo proceso.
DELIVERY_URL=

# Cada cuánto se vuelve a bajar el catálogo de Ventra, EN MILISEGUNDOS. Por defecto 12 h.
# Se puede saltar de una vez con `?forzar=1`.
CATALOGO_CADA_MS=

# Cuánto se recuerda la lista de almacenes de Accesos, EN MILISEGUNDOS. Por defecto 5 min:
# hacen falta para medir CADA domicilio y no cambian de un minuto a otro. Sin recuerdo,
# cotizar un lote de 200 pedidos son 200 llamadas a Accesos.
ALMACENES_CACHE_MS=

# --- Accesos (el login único) ---------------------------------------------------
#
# De ahí salen los almacenes y las tasas. Accesos NO acepta una clave suelta en una
# cabecera: cada aplicación firma con SU llave (HMAC-SHA256 sobre método, ruta, hora, un
# nonce y el hash del cuerpo), así que una petición copiada de un registro no sirve al
# minuto siguiente. Se reutiliza la llave del login único en vez de abrir otra puerta.
#
# Sin la llave, el cliente lo dice ANTES de salir a la red: un «401 de auth» es mucho más
# difícil de relacionar con una variable que falta.
PROCOVAR_AUTH_SIGNING_KEY=
PROCOVAR_AUTH_URL=https://auth.procovar.cloud
PROCOVAR_AUTH_CLIENT_ID=delivery

# --- Ventra (el ERP), de donde sale el catálogo ---------------------------------
#
# Es una API HTTP de SÓLO LECTURA (`docs/API-VENTRA.md`), no un MySQL, y sólo se llega por
# la VPN de WireGuard (red 10.188.2.0/24). De ahí salen el nombre, el peso, el precio y las
# existencias de cada producto, SUCURSAL POR SUCURSAL.
#
# HACEN FALTA LAS DOS. Con las dos puestas, el arranque enchufa el lector y lo dice; si
# falta una, el servicio arranca igual —el reparto funciona— pero `POST /api/products/sync`
# contesta 502 diciendo que no hay lector, y los productos se quedan con el peso y el precio
# de la última bajada buena. Nunca un 200 con «0 productos escritos».
#
# En producción la URL es http://10.188.2.2:3001/api/external-api y el token es uno
# permanente de Ventra (scope axis.read). AQUÍ NO HAY VALOR POR DEFECTO a propósito:
# enchufar el lector tiene que ser un acto explícito de quien despliega.
WAREHOUSE_API_URL=
WAREHOUSE_API_TOKEN=

# Lo que se espera a cada petición de Ventra, EN MILISEGUNDOS. Por defecto 30 s: es un ERP
# al otro lado de una VPN, no una API de al lado.
WAREHOUSE_TIMEOUT_MS=

# Empareja NUESTRO código de sucursal con el slug de la base de Ventra, separado por comas
# (`STG=santiago,HOL=holguinmoa`). Normalmente vacía: el cliente ya trae la tabla de las
# diez bases de hoy y las pregunta a /axis/databases. Está para el día que Ventra añada o
# renombre una — si no, esa sucursal se queda sin catálogo sin que salte nada.
VENTRA_BASES=
